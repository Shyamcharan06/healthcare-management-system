SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# DB_ENGINE=postgresql (default) or sqlite3 for a zero-setup local DB
DB_ENGINE=postgresql
DB_NAME=healthcare_db
DB_USER=healthcare_user
DB_PASSWORD=healthcare_pass
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=UTC

# Default admin account created by the accounts migration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Path to tesseract.exe on Windows if it is not on PATH, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
